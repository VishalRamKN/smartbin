# Give the ESP32 a fixed name, /dev/smartbin, whichever USB port it is plugged into.
# Covers the USB-serial chips used on ESP32 DevKits: CP2102/CP2104, CH340, CH9102.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="smartbin", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="smartbin", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", SYMLINK+="smartbin", MODE="0660", GROUP="dialout"
