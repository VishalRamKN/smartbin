# SmartBin hub settings. setup_pi.sh copies this to hub/hub.env; edit that copy, then
#   sudo systemctl restart smartbin-hub

SMARTBIN_PORT=/dev/smartbin
SMARTBIN_HTTP_PORT=8080
SMARTBIN_HUB_ID=HUB-01

# Status thresholds (fill %)
SMARTBIN_FILLING_PCT=50
SMARTBIN_FULL_PCT=80

# Bridging check: a FULL bin lighter than this many grams per litre is flagged CHECK.
# After 5 genuine FULL readings the hub learns its own threshold (half the median density).
SMARTBIN_BUCKET_L=0.20
SMARTBIN_RHO_MIN=15

# Cloud server (AWS Lightsail). Leave empty to run local-only; readings are kept and sent later.
SMARTBIN_CLOUD_URL=
SMARTBIN_CLOUD_KEY=
